{
  "name": "my-voice-landing",
  "version": "1.0.0",
  "private": true,
  "description": "Bilingual (EN/RU) landing page for the My Voice AAC project.",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build && vite build --ssr src/entry-server.jsx --outDir dist-ssr && node scripts/build/prerender.mjs",
    "test": "vitest run",
    "test.built": "vitest run --config vitest.built.config.js",
    "audit": "node scripts/audit/run.mjs",
    "preview": "vite preview --host 0.0.0.0"
  },
  "dependencies": {
    "@fontsource/andika": "^5.3.0",
    "@fontsource/open-sans": "^5.3.0",
    "@fontsource/unbounded": "^5.3.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^31.0.0",
    "sharp": "^0.35.5",
    "vite": "^5.4.11",
    "vitest": "^2.1.9"
  }
}
