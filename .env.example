# My Voice landing page: every link and contact detail the page needs.
#
# HOW IT WORKS
#   * Local: copy this file to `.env.local` (git-ignored), fill in what you have,
#     then run `npm run dev` or `npm run build`.
#   * Deploy: create a repository variable for each line (Settings, Secrets and
#     variables, Actions, Variables). The names below minus the `VITE_` prefix are
#     the variable names the workflow reads, for example GOOGLE_PLAY_URL.
#   * Leave a value empty (or delete the line) when the thing does not exist yet.
#     Its button then shows as disabled and its description says "Coming soon"
#     (Скоро on the Russian page). Fill it in and rebuild: the button turns on.
#   * Everything here ends up in the public page. Never put a secret in this file.
#   * Values are read when the site is built. Changing one means building and
#     deploying again.

# --- Download buttons (top of the page and the "Try My Voice" band) ------------

# Google Play listing, e.g. https://play.google.com/store/apps/details?id=...
# When this is set, replace the drawn badge with Google's official badge artwork.
VITE_GOOGLE_PLAY_URL=

# "Want it on iOS?" interest form (Google Forms or similar), full https:// URL,
# one for each language page.
VITE_IOS_INTEREST_URL_EN=
VITE_IOS_INTEREST_URL_RU=

# --- Other ways to get the app ("Other ways to get it", in the band at the bottom) ---

# F-Droid listing, e.g. https://f-droid.org/packages/<package>
VITE_STORE_FDROID_URL=

# RuStore listing. Shown on the Russian page only.
VITE_STORE_RUSTORE_URL=

# Direct link to the APK file: a full https:// URL (for example a GitHub release
# asset) or a path inside this site such as apk/my-voice.apk (file in public/apk/).
VITE_STORE_APK_URL=

# --- Manuals (PDF) -------------------------------------------------------------

# Either a full https:// URL, or a path under public/, for example
# manuals/my-voice-en.pdf for the file public/manuals/my-voice-en.pdf.
# A relative path works from both the English and the Russian page.
VITE_MANUAL_EN_URL=
# Optional, shown next to "PDF", for example 2.4 MB
VITE_MANUAL_EN_SIZE=

VITE_MANUAL_RU_URL=
VITE_MANUAL_RU_SIZE=

# --- Survey about experience with My Voice ("Share your experience") ------------
# The first survey is closed. Put the link to the new one here when it is published,
# one for each language page. Until then the link shows as "Coming soon".
VITE_SURVEY_URL_EN=
VITE_SURVEY_URL_RU=

# --- Contact (footer) ----------------------------------------------------------

# Public contact address, shown as a mailto: link. It is never written in the source.
VITE_CONTACT_EMAIL=
